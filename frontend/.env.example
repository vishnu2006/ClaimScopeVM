# ClaimScope Frontend Environment Template
# For local development: copy to frontend/.env.local
# For Cloudflare: add to Cloudflare Dashboard -> Settings -> Environment Variables

# Point this to your backend API URL (include /api/v1):
# Local: http://localhost:8000/api/v1
# Production: https://claimscope-api.onrender.com/api/v1 (or your Render URL)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Firebase Client Configuration (Firebase Console -> Project Settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="claimscope-xxx.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="claimscope-xxx"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="claimscope-xxx.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
