# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/claimscope

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:3000

# Debug
DEBUG=false
