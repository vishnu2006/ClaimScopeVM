# ClaimScope Production Backend Environment Template
# Copy this to backend/.env for local development or enter these in Render Dashboard -> Environment

# Application settings
APP_NAME="ClaimScope API"
APP_VERSION="0.2.0"
DEBUG=False

# Database Persistence
# For local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./claimscope.db"
# For Render Production (attach free Render PostgreSQL database and paste Internal Database URL):
# DATABASE_URL="postgresql+asyncpg://claimscope_user:PASSWORD@dpg-xxxxxx-a/claimscope_db"

# Storage Directory
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=50

# AI Configuration (STRICTLY BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# Production CORS
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://claimscope.pages.dev"
# Automatically permits all Cloudflare Pages preview URLs (https://<branch>.<project>.pages.dev)
CORS_ORIGIN_REGEX="^https:\/\/.*\.pages\.dev$"
