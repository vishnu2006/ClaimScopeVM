# Database (PostgreSQL or local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./claimscope.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/claimscope

# Google Gemini API (ONLY model provider for ClaimScope)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:3000

# Debug
DEBUG=false
