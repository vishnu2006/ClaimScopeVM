# ClaimScope Production Backend Environment Template
# Copy this to backend/.env for local development or enter these in Render Dashboard -> Environment

# Application settings
APP_NAME="ClaimScope API"
APP_VERSION="0.2.0"
DEBUG=False

# Database Persistence
# For local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./claimscope.db"
# For Render Production (attach free Render PostgreSQL database and paste Internal Database URL):
# DATABASE_URL="postgresql+asyncpg://claimscope_user:PASSWORD@dpg-xxxxxx-a/claimscope_db"

# Storage Directory
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=50

# AI Configuration (STRICTLY BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# Production CORS
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://claimscopevm.vishnu-pandrangi123.workers.dev,https://aethergraph.in,https://www.aethergraph.in"
CORS_ORIGIN_REGEX="^https:\/\/(.*\.(pages\.dev|workers\.dev)|aethergraph\.in|localhost(:\d+)?)$"

# Firebase Authentication (Firebase Admin SDK)
# Option A (Recommended for Render): Paste entire service account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option B (Recommended for local dev): Path to service account json file
# FIREBASE_SERVICE_ACCOUNT_PATH="serviceAccountKey.json"
# Project ID (fallback if not using service account)
FIREBASE_PROJECT_ID="claimscope-xxx"
# Set to True in production to strictly reject unauthenticated API requests
REQUIRE_AUTH=False
